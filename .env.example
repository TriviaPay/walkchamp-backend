# Walk Champ — Backend environment variables
# Copy to .env and fill in your values.

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
APP_PROCESS_ROLE=api

# Public API base URL (used for payment redirects and webhooks)
APP_BASE_URL=http://localhost:8080

# Comma-separated exact CORS origins (required in production)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
TRUST_PROXY_HOPS=1

# Set to false on all but one replica when running multiple backend instances.
RUN_BACKGROUND_JOBS=true
ENABLE_RATE_LIMITING=false
REDIS_URL=
REDIS_CACHE_URL=
REDIS_QUEUE_URL=
REDIS_LIVE_URL=
ENABLE_REDIS_PRESENCE_MIRROR_WRITE=false
ENABLE_REDIS_PRESENCE_SERVE=false
ENABLE_REDIS_WALK_SHADOW_WRITE=false
ENABLE_REDIS_WALK_SERVE=false
REDIS_WALK_CANARY_PERCENT=0
ENABLE_REDIS_LEADERBOARD_MIRROR_WRITE=false
ENABLE_REDIS_LEADERBOARD_SERVE=false
MOCK_PROVIDERS_ENABLED=false
ALLOW_TEST_ROUTES=false
ALLOW_DEMO_SEEDS=false

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_RUNTIME_URL=
DATABASE_ADMIN_URL=
NEON_DATABASE_URL=
NEON_DATABASE_ADMIN_URL=
# Alternative name (falls back if NEON_DATABASE_URL is unset)
DATABASE_URL=

# ── Auth (Descope) ─────────────────────────────────────────────────────────────
DESCOPE_PROJECT_ID=
DESCOPE_MANAGEMENT_KEY=
SESSION_SECRET=
APPLE_EXPECTED_AUDIENCES=com.globalwalkerleague.app
# Exact-match allowlist for the redirectUrl accepted by POST /api/auth/oauth/start.
# Leave unset to derive it from the native deep-link scheme plus ALLOWED_ORIGINS/APP_BASE_URL;
# set it (comma-separated) to override that list outright. Never widen this to a wildcard —
# the endpoint is unauthenticated, so a permissive value hands the OAuth code to any host.
OAUTH_ALLOWED_REDIRECT_URLS=

# ── Real-time (Pusher) ─────────────────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# ── Push notifications (OneSignal) ────────────────────────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ── Payments ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Additional per-player platform fee for cash challenges, in cents.
CASH_CHALLENGE_PLATFORM_SERVICE_FEE_CENTS=60
# Both must be "true" for paid cash challenges ($3/$5/etc.) to work.
CASH_FEATURES_ENABLED=false
# Allow India (Razorpay) profiles into the cash-challenge flow. Leave false in production
# until the Razorpay cash path has been run end to end; set true in staging/test to try it
# with Razorpay test keys. Amounts stay USD-denominated either way — the wallet-currency
# guard in debitWalletForCashChallenge still refuses any non-USD wallet.
ENABLE_INR_CASH_CHALLENGES=false
# Razorpay processing fee in basis points (200 = 2%, their standard domestic card rate).
# Percentage only; unlike Stripe there is no fixed per-transaction component.
CASH_CHALLENGE_RAZORPAY_PROCESSING_BASIS_POINTS=200

# ── Voice (LiveKit) ────────────────────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Object storage (Cloudflare R2 / S3-compatible) ────────────────────────────
OBJECT_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=https://assets.example.com
BACKUP_OBJECT_PREFIX=backups/production

# ── Monitoring ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ── Admin ──────────────────────────────────────────────────────────────────────
ADMIN_API_KEY=
ADMIN_SERVICE_KEY=
ADMIN_USER_IDS=
# Comma-separated test/system accounts omitted from challenge participation analytics.
PARTICIPATION_EXCLUDED_USER_IDS=

# ── Feature flags (env overrides) ──────────────────────────────────────────────
# Both must be "true" for paid cash challenges ($3/$5/etc.) to work.
FEATURE_CASH_FEATURES=false
FEATURE_COIN_ENTRY_CHALLENGES=false
FEATURE_LEGACY_PRESENCE_ONLINE_IDS=false

# ── In-app purchases (Mic Pass + coin packs) ──────────────────────────────────
# POST /api/purchases/verify asks the store directly; without these it answers
# IAP_VERIFICATION_NOT_CONFIGURED for that platform and grants nothing.
#
# Apple: App Store Connect → Users and Access → Integrations → In-App Purchase key.
# APPLE_IAP_PRIVATE_KEY is the .p8 contents (real newlines or literal \n both work).
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.globalwalkerleague.app
# Accept sandbox/TestFlight receipts. Keep true — App Review buys in sandbox.
APPLE_IAP_ALLOW_SANDBOX=true
#
# Google Play: a service account with the "View financial data" permission in Play Console,
# granted access to this app. Paste the whole service-account JSON, or split out the two fields.
GOOGLE_PLAY_PACKAGE_NAME=com.globalwalkerleague.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_CLIENT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=
# Accept license-tester purchases. Keep true for internal testing tracks.
GOOGLE_PLAY_ALLOW_TEST_PURCHASES=true
#
# QA-only escape hatch: lets platform:"dev" unlock with no store receipt. Defaults to on
# outside production and off in production. Never set true on the real production deployment.
ENABLE_DEV_IAP_PURCHASES=false
